			<example correction="kasalimuotan">Ang <marker>kasalimuutan</marker> ng problèma.</example>
			<example type="correct">kabuoan</example>
		</rule>
		<rule id="DOBLENG_OO" name="Pagpapanatili ng 'oo'">
			<pattern case_sensitive="no">
